{
  "name": "aangan-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ts:check": "tsc --noEmit",
    "api:types": "openapi-typescript ./openapi.json -o lib/api-types.gen.ts",
    "api:types:remote": "openapi-typescript ${EXPO_PUBLIC_API_URL:-https://backend-service-production-2df4.up.railway.app}/openapi.json -o lib/api-types.gen.ts",
    "test": "jest --forceExit --detectOpenHandles",
    "test:ci": "jest --ci --coverage --forceExit --detectOpenHandles",
    "e2e": "JAVA_HOME=/usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home maestro test .maestro/",
    "e2e:smoke": "JAVA_HOME=/usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home maestro test .maestro/ --tags smoke",
    "e2e:ci": "JAVA_HOME=/usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home maestro test --format junit --output e2e-results.xml .maestro/",
    "build:dev": "eas build --profile development --platform all --non-interactive",
    "build:preview": "eas build --profile preview --platform all --non-interactive",
    "build:prod": "eas build --profile production --platform all --non-interactive",
    "submit:ios": "eas submit --platform ios --latest --non-interactive",
    "submit:android": "eas submit --platform android --latest --non-interactive",
    "release": "npm run build:prod && npm run submit:ios && npm run submit:android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/native": "^7.0.14",
    "@sentry/react-native": "~8.28.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.3",
    "expo-asset": "~58.0.21",
    "expo-auth-session": "~58.0.19",
    "expo-blur": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "expo-video": "~58.0.14",
    "expo-video-thumbnails": "~58.0.3",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-cashfree-pg-sdk": "^2.5.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-qrcode-svg": "^6.3.23",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
