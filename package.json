{
  "name": "aangan-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ts:check": "tsc --noEmit",
    "api:types": "openapi-typescript ./openapi.json -o lib/api-types.gen.ts",
    "api:types:remote": "openapi-typescript ${EXPO_PUBLIC_API_URL:-https://backend-service-production-2df4.up.railway.app}/openapi.json -o lib/api-types.gen.ts",
    "test": "jest --forceExit --detectOpenHandles",
    "test:ci": "jest --ci --coverage --forceExit --detectOpenHandles",
    "e2e": "JAVA_HOME=/usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home maestro test .maestro/",
    "e2e:smoke": "JAVA_HOME=/usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home maestro test .maestro/ --tags smoke",
    "e2e:ci": "JAVA_HOME=/usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home maestro test --format junit --output e2e-results.xml .maestro/",
    "build:dev": "eas build --profile development --platform all --non-interactive",
    "build:preview": "eas build --profile preview --platform all --non-interactive",
    "build:prod": "eas build --profile production --platform all --non-interactive",
    "submit:ios": "eas submit --platform ios --latest --non-interactive",
    "submit:android": "eas submit --platform android --latest --non-interactive",
    "release": "npm run build:prod && npm run submit:ios && npm run submit:android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/native": "^7.0.14",
    "@sentry/react-native": "~7.2.0",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.23",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
